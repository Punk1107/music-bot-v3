# Music Bot V3 (Gen 5.0) — Environment Configuration
# Copy this file to .env and fill in your values.

# ─── REQUIRED ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
APP_ID=your_application_id_here

# ─── SPOTIFY (optional) ───────────────────────────────────────────────────────
# Leave blank to disable Spotify support (YouTube-only mode)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── DATABASE (MySQL 8.0+ Enterprise Pool) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=musicbot
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=25
DB_CHARSET=utf8mb4
DB_AUTOCOMMIT=false
DB_CONNECT_TIMEOUT=10.0
DB_DEADLOCK_RETRIES=3

# Migration & Cutover Feature Flag: mysql | dual_write | sqlite_fallback
DB_MIGRATION_MODE=mysql
# Legacy SQLite path (for migration script, dual_write & rollback)
DATABASE_PATH=data/musicbot.db
# Automated analytics cleanup retention (days)
ANALYTICS_RETENTION_DAYS=90

# Phase 2: Worker / Dashboard Separation
WORKER_ID=
DASHBOARD_STANDALONE_POOL=false

# Phase 3: Optional Master-Replica & Distributed Guild Sharding
DB_REPLICA_HOST=
DB_REPLICA_PORT=3306
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=
DB_SHARDS_JSON=[]

# ─── BOT BEHAVIOUR ───────────────────────────────────────────────────────────
# Sync slash commands on startup (only needed after adding/removing commands)
SYNC_COMMANDS=false
# Auto-resume queues on startup from DB
AUTO_RESUME=false
# Auto-disconnect after N seconds of silence (default: 300 = 5 min)
IDLE_TIMEOUT=300
# Max consecutive broken track auto-skips
SKIP_ERROR_LIMIT=5
# Dev channels to forward full tracebacks — comma-separated for multiple servers
DEV_LOG_CHANNEL_IDS=
# Legacy single-channel alias (kept for backward compat)
DEV_LOG_CHANNEL_ID=

# ─── AUTO-PLAYLIST (V3 NEW) ───────────────────────────────────────────────────
# Auto-fill queue from history when queue becomes empty
AUTO_PLAYLIST=false
AUTO_PLAYLIST_SIZE=5

# ─── SMART AUTOPLAY (Feature 1.4) ─────────────────────────────────────────────
# Automatically play YouTube related videos when the queue empties
SMART_AUTOPLAY=false
SMART_AUTOPLAY_FETCH_SIZE=8
SMART_AUTOPLAY_HISTORY_SIZE=100

# ─── FAVORITES (V3 NEW) ───────────────────────────────────────────────────────
MAX_FAVORITES_PER_USER=50

# ─── NLU (V3: Regex engine, no external API) ─────────────────────────────────
NLU_ENABLED=true

# ─── WEBSERVER ────────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Bearer token for REST API authentication — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET=
# REST API requests per minute per IP
API_RATE_LIMIT=60

# ─── AUDIO ───────────────────────────────────────────────────────────────────
# Netscape-format cookie file exported from browser (safe to leave as default, loaded only if file exists)
YTDL_COOKIE_FILE=cookies.txt
# Optional PO-Token for bypassing YouTube bot detection (Feature 1.6)
YTDL_PO_TOKEN=
YTDL_AUDIO_FORMAT=bestaudio/best
YTDL_RETRIES=3
YTDL_TIMEOUT=30.0
YTDL_STREAM_TIMEOUT=20.0
YTDL_CACHE_TIMEOUT=1800.0
YTDL_CACHE_MAX_SIZE=512
SEARCH_CACHE_TTL=600.0
SEARCH_CACHE_MAX_SIZE=256
STREAM_URL_TTL=14400.0
MAX_TRACK_LENGTH=7200
MAX_PLAYLIST_TRACKS=100
MAX_QUEUE_SIZE=500

# ─── PERFORMANCE ─────────────────────────────────────────────────────────────
# Max concurrent yt-dlp extraction tasks
EXTRACT_CONCURRENCY=3
# Max concurrent bulk playlist extraction tasks
PLAYLIST_EXTRACT_CONCURRENCY=2
# Max concurrent dominant-color extraction tasks
COLOR_EXTRACT_CONCURRENCY=3
# Queue auto-save interval in seconds
QUEUE_SAVE_INTERVAL=300

# ─── CIRCUIT BREAKER ─────────────────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW=60.0

# ─── VOICE RECONNECT ─────────────────────────────────────────────────────────
RECONNECT_ATTEMPTS=3
RECONNECT_BASE_DELAY=2.0
